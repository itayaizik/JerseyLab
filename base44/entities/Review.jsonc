{
  "name": "Review",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "rating",
    "comment"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.approved": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}