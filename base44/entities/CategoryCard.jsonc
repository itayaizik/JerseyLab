{
  "name": "CategoryCard",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "href": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "format": "image_url"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}